@inherits LayoutComponentBase


<div class="page-wrapper">
    <header class="fixed-top shadow-sm">
        <NavMenu />
    </header>

    <main style="margin-top: 100px; min-height: calc(100vh - 100px - 250px);">
        @Body
    </main>

    <footer class="bg-dark text-white py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="text-uppercase fw-bold mb-3">Museo Civico Aurora</h5>
                    <p>Via della Cultura, 1<br />00100 Roma (RM)<br />Italia</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5 class="text-uppercase fw-bold mb-3">Orari</h5>
                    <p>Lunedì - Venerdì: 09:00 - 19:00<br />Sabato - Domenica: 10:00 - 20:00</p>
                </div>
                <div class="col-md-4 mb-3 text-md-end">
                    <a href="/tickets" class="btn fw-bold rounded-0" style="background-color: #f3a446; color: #000; padding: 12px 30px;">ACQUISTA BIGLIETTI</a>
                </div>
            </div>
            <div class="border-top border-secondary mt-4 pt-3 text-center text-secondary small">
                &copy; @DateTime.Now.Year Museo Civico Aurora. Tutti i diritti riservati.
            </div>
        </div>
    </footer>
</div>
