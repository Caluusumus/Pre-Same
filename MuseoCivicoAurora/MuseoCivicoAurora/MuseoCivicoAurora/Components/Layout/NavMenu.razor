@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
    <div class="container-fluid px-4">

        <a class="navbar-brand fw-bold fs-4 text-uppercase" href="" style="letter-spacing: 1px;">
            Aurora <span style="color: #f3a446;">Museum</span>
        </a>

        <button class="navbar-toggler rounded-0" type="button" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass navbar-collapse" @onclick="CollapseNavMenu">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 fw-semibold text-uppercase align-items-center" style="font-size: 0.9rem; letter-spacing: 0.5px;">

                <li class="nav-item me-3">
                    <NavLink class="nav-link text-dark" href="" Match="NavLinkMatch.All">Home</NavLink>
                </li>
                <li class="nav-item me-3">
                    <NavLink class="nav-link text-dark" href="exhibitions">Mostre</NavLink>
                </li>
                <li class="nav-item me-3">
                    <NavLink class="nav-link text-dark" href="artworks">Opere</NavLink>
                </li>
                <li class="nav-item me-3">
                    <NavLink class="nav-link text-dark" href="tours">Visite</NavLink>
                </li>
                <li class="nav-item me-3">
                    <NavLink class="nav-link text-dark" href="bookings">Prenotazioni</NavLink>
                </li>
                <li class="nav-item me-4">
                    <NavLink class="nav-link text-dark" href="tickets">Biglietti</NavLink>
                </li>

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item me-3">
                            <NavLink class="nav-link text-dark" href="Account/Manage">
                                Ciao, @context.User.Identity?.Name
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <form action="Account/Logout" method="post" class="d-inline m-0 p-0">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="nav-link text-dark bg-transparent border-0 fw-semibold text-uppercase m-0" style="font-size: 0.9rem; letter-spacing: 0.5px; cursor: pointer;">
                                    Logout
                                </button>
                            </form>
                        </li>
                    </Authorized>

                    <NotAuthorized>
                        <li class="nav-item me-3">
                            <NavLink class="nav-link text-dark" href="Account/Register">Registrati</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link text-dark" href="Account/Login">Accedi</NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>

            </ul>
        </div>

    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private void CollapseNavMenu() => collapseNavMenu = true;

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}