@page "/artworks"
@using MuseoCivicoAurora.shared
@using MuseoCivicoAurora.Client.Services
@inject IArtworkApiClient ApiClient
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <h1 class="display-4 fw-bold text-uppercase m-0">Collezione Opere</h1>
        <AuthorizeView Roles="Admin">
        <a href="/artworks/edit" class="btn btn-primary btn-lg">+ Nuova Opera</a>
        </AuthorizeView>
    </div>

    @if (artworks == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-dark"></div></div>
    }
    else if (!artworks.Any())
    {
        <p class="lead text-muted">Nessuna opera presente. Aggiungine una!</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var artwork in artworks)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-0">
                        <div style="height: 300px; background-color: #eaeaea; overflow: hidden;" class="position-relative">
                            @if (!string.IsNullOrWhiteSpace(artwork.Image))
                            {
                                <img src="@artwork.Image" class="w-100 h-100" style="object-fit: contain;" alt="@artwork.Title">
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">No Immagine</div>
                            }
                        </div>

                        <div class="card-body bg-white p-4 d-flex flex-column">
                            <h4 class="fw-bold text-uppercase mb-1">@artwork.Title</h4>
                            <p class="fst-italic text-muted mb-3">di @(string.IsNullOrWhiteSpace(artwork.Artist) ? "Autore Ignoto" : artwork.Artist)</p>

                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                <a class="btn btn-info flex-grow-1" @onclick="() => Details(artwork.Id)">Dettagli</a>
                                <AuthorizeView Roles="Admin">                                    
                                <a class="btn btn-warning" @onclick="() => Edit(artwork.Id)"><i class="bi bi-pencil"></i> Modifica</a>
                                <a class="btn btn-danger" @onclick="() => Delete(artwork.Id)"><i class="bi bi-trash"></i> X</a>                                   
                                </AuthorizeView>
                            </div>
                            
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Artwork>? artworks;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        artworks = await ApiClient.GetArtworksAsync();
    }


    private void CreateNew()
    {
        NavigationManager.NavigateTo("/artworks/edit");
    }

    private void Details(Guid id)
    {
        NavigationManager.NavigateTo($"/artworks/details/{id}");
    }

    private void Edit(Guid id)
    {
        NavigationManager.NavigateTo($"/artworks/edit/{id}");
    }

    private async Task Delete(Guid id)
    {
        await ApiClient.DeleteArtworkAsync(id);
        await LoadData();
    }
}