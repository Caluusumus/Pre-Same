@page "/tours/details/{Id:guid}"
@rendermode InteractiveWebAssembly
@using MuseoCivicoAurora.shared
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavigationManager

<div class="container my-5">
    @if (tour == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-dark"></div></div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
            <h1 class="display-4 fw-bold text-uppercase m-0">@tour.Title</h1>

            <AuthorizeView Roles="Admin">
                <div>
                    <a class="btn btn-outline-dark fw-bold" @onclick="() => Edit(tour.Id)">Modifica Visita</a>
                </div>
            </AuthorizeView>
        </div>

        <div class="row g-5">
            <div class="col-md-5">
                <div class="card border-0 shadow-sm rounded-0 bg-white p-4">
                    <h4 class="fw-bold text-uppercase mb-4 border-bottom pb-2">Dettagli Visita</h4>

                    <ul class="list-unstyled mb-0" style="line-height: 2.2;">
                        <li><strong class="text-muted me-2">Data e Ora:</strong> <span class="fw-bold">@(tour.DateTime?.ToString("dd MMMM yyyy, HH:mm") ?? "Non definita")</span></li>
                        <li><strong class="text-muted me-2">Durata stimata:</strong> @(tour.Duration?.ToString("HH:mm") ?? "Non definita")</li>
                        <li><strong class="text-muted me-2">Guida assegnata:</strong> @(string.IsNullOrWhiteSpace(tour.Guide) ? "Da confermare" : tour.Guide)</li>
                        <li><strong class="text-muted me-2">Posti Totali:</strong> @tour.ParticipantsCount persone</li>
                    </ul>

                    @if (relatedExhibition != null)
                    {
                        <div class="mt-4 p-3 bg-light border-start border-warning border-4">
                            <span class="d-block text-muted small fw-bold text-uppercase mb-1">Inclusa nella mostra</span>
                            <a href="/exhibitions/details/@relatedExhibition.Id" class="text-dark fw-bold text-decoration-none fs-5">
                                @relatedExhibition.Title
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-7 d-flex flex-column">
                <h5 class="text-muted text-uppercase fw-bold mb-3">Informazioni sul percorso</h5>

                @if (!string.IsNullOrWhiteSpace(tour.Description))
                {
                    <p class="fs-5 text-dark" style="line-height: 1.8;">@tour.Description</p>
                }
                else
                {
                    <p class="text-muted fst-italic">Nessuna descrizione disponibile per questa visita guidata.</p>
                }

                <div class="mt-auto pt-5">
                    <div class="p-4 bg-light border-0 shadow-sm rounded-0 border-top border-dark border-3">
                        <h4 class="fw-bold mb-2">Partecipa a questa visita</h4>
                        <p class="text-muted mb-4">Assicurati il tuo posto prenotando in anticipo. La disponibilità è limitata.</p>

                        <div class="d-flex flex-wrap gap-3">
                            <AuthorizeView>
                                <Authorized>
                                    <a class="btn btn-warning btn-lg fw-bold rounded-0 px-5" @onclick="Book">PRENOTA ORA</a>
                                </Authorized>
                                <NotAuthorized>
                                    <a href="/Account/Login" class="btn btn-dark btn-lg fw-bold rounded-0 px-4">ACCEDI PER PRENOTARE</a>
                                </NotAuthorized>
                            </AuthorizeView>

                            <a href="/tours" class="btn btn-outline-secondary btn-lg fw-bold rounded-0">Torna alla lista</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Tour? tour;
    private Exhibition? relatedExhibition;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tour = await Http.GetFromJsonAsync<Tour>($"api/tours/{Id}");

            if (tour != null && tour.ExhibitionId.HasValue && tour.ExhibitionId != Guid.Empty)
            {
                relatedExhibition = await Http.GetFromJsonAsync<Exhibition>($"api/exhibitions/{tour.ExhibitionId.Value}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Errore nel caricamento dei dettagli della visita: {ex.Message}");
        }
    }

    private void Book()
    {
        NavigationManager.NavigateTo($"/bookings/edit?tourId={Id}");
    }

    private void Edit(Guid id)  
    {
        NavigationManager.NavigateTo($"/tours/edit/{id}");
    }
}