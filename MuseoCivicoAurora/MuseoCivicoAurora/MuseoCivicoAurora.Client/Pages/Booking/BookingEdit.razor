@page "/bookings/edit"
@page "/bookings/edit/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@using MuseoCivicoAurora.shared
@using MuseoCivicoAurora.Client.Services
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

@inject IBookingApiClient BookingApi
@inject ITourApiClient TourApi
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="container my-5">
    <h1 class="mb-4">@(Id == null ? "Prenota una Visita Guidata" : "Modifica Prenotazione")</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm fw-bold">@errorMessage</div>
    }

    @if (tours == null)
    {
        <p><em>Caricamento visite disponibili...</em></p>
    }
    else
    {
        <EditForm Model="booking" OnValidSubmit="Save" FormName="formPrenotazione" class="card shadow-sm p-4 border-0">
            <DataAnnotationsValidator />
            <ValidationSummary style="color: red; font-weight: bold; margin-bottom: 15px;" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nome:</label>
                    <InputText class="form-control" @bind-Value="booking.FirstName" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Cognome:</label>
                    <InputText class="form-control" @bind-Value="booking.LastName" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Email di riferimento (*):</label>
                <InputText class="form-control" @bind-Value="booking.Email" disabled="@(!isAdmin)" />
                @if (!isAdmin)
                {
                    <small class="text-muted">L'email è fissa ed è associata al tuo account.</small>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Seleziona la Visita Guidata (*):</label>
                <InputSelect TValue="Guid" class="form-control" @bind-Value="booking.TourId">
                    <option value="@Guid.Empty">-- Scegli la visita --</option>
                    @foreach (var tour in tours.Where(t => t.DateTime >= DateTime.Now))
                    {
                        <option value="@tour.Id">@tour.Title (@tour.DateTime?.ToString("dd/MM/yyyy HH:mm")) - Max @tour.ParticipantsCount persone</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-4">
                <label class="form-label">Numero di Partecipanti:</label>
                <InputNumber class="form-control" @bind-Value="booking.ParticipantsCount" min="1" />
            </div>

            <AuthorizeView Roles="Admin" Context="authContext">
                <div class="mb-4 border-start border-warning ps-3">
                    <label class="form-label text-warning fw-bold">Stato (Solo Admin):</label>
                    <InputSelect class="form-control" @bind-Value="booking.Status">
                        <option value="confirmed">Confermata</option>
                        <option value="cancelled">Annullata</option>
                    </InputSelect>
                </div>
            </AuthorizeView>

            <div>
                <a type="submit" class="btn btn-success fw-bold px-4">Conferma Prenotazione</a>
                <a href="/bookings" class="btn btn-secondary ms-2">Annulla</a>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery] public Guid? tourId { get; set; }

    private Booking booking = new Booking { Status = "confirmed", ParticipantsCount = 1 };
    private List<Tour>? tours;
    private string errorMessage = string.Empty;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAdmin = authState.User.IsInRole("Admin");

            if (!Id.HasValue)
                booking.Email = authState.User.Identity?.Name ?? "";

            if (tourId.HasValue && tourId != Guid.Empty)
                booking.TourId = tourId.Value;

            // USING INTERFACE INSTEAD OF HTTP
            var fetchedTours = await TourApi.GetToursAsync();
            tours = fetchedTours?.ToList();

            if (Id.HasValue)
            {
                // Fallback to HTTP for specific fetch if your Interface doesn't have GetById yet
                var fetchedBooking = await Http.GetFromJsonAsync<Booking>($"api/bookings/{Id.Value}");
                if (fetchedBooking != null) booking = fetchedBooking;
            }
        }
        catch (Exception ex) { errorMessage = $"Initialization Error: {ex.Message}"; }
    }

    private async Task Save()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(booking.Email)) { errorMessage = "L'email è obbligatoria."; return; }
        if (booking.TourId == Guid.Empty) { errorMessage = "Selezionare una Visita Guidata."; return; }
        if (booking.ParticipantsCount <= 0) { errorMessage = "Seleziona almeno un partecipante."; return; }

        var selectedTour = tours?.FirstOrDefault(t => t.Id == booking.TourId);
        if (selectedTour != null)
        {
            if (selectedTour.DateTime < DateTime.Now)
            {
                errorMessage = "ERRORE: Non è possibile prenotare una visita passata."; return;
            }

            // --- REAL CAPACITY VALIDATION LOGIC ---
            var allBookings = await BookingApi.GetBookingsAsync();

            // Calculate seats currently occupied by OTHER confirmed bookings for this tour
            var occupiedSeats = (allBookings ?? new List<Booking>())
                .Where(b => b.TourId == selectedTour.Id && b.Status == "confirmed" && b.Id != booking.Id)
                .Sum(b => b.ParticipantsCount);

            var remainingSeats = selectedTour.ParticipantsCount - occupiedSeats;

            if (booking.ParticipantsCount > remainingSeats)
            {
                errorMessage = $"ERRORE: Posti esauriti. Rimangono solo {remainingSeats} posti disponibili per questa visita.";
                return;
            }
            // --------------------------------------
        }

        try
        {
            HttpResponseMessage response;

            if (Id.HasValue)
            {
                response = await Http.PutAsJsonAsync($"api/bookings/{Id.Value}", booking);
            }
            else
            {
                booking.Id = Guid.NewGuid();
                booking.CreatedAt = DateTime.Now;
                response = await Http.PostAsJsonAsync("api/bookings", booking);
            }

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/bookings");
            }
            else
            {
                errorMessage = "Errore durante il salvataggio. Controlla i dati.";
            }
        }
        catch (Exception ex) { errorMessage = $"Network Error: {ex.Message}"; }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/bookings");
    }
}