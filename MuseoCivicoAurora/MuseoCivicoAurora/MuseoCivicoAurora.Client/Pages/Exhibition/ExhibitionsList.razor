@page "/exhibitions"
@using ClassModels
@using MuseoCivicoAurora.Client.Services
@inject ExhibitionApiClient ApiClient
@inject NavigationManager NavigationManager
@rendermode InteractiveWebAssembly

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <h1 class="display-4 fw-bold text-uppercase m-0">Mostre in Corso</h1>

        <AuthorizeView Roles="Admin">
            <a href="/exhibitions/edit" class="btn btn-primary btn-lg">+ Nuova Mostra</a>
        </AuthorizeView>
    </div>

    @if (exhibitions == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-dark"></div></div>
    }
    else if (!exhibitions.Any())
    {
        <p class="lead text-muted">Nessuna mostra programmata al momento.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var exhibition in exhibitions)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-0 flex-md-row">
                        <div class="col-md-4 p-0 position-relative" style="min-height: 250px; background-color: #eaeaea;">
                            @if (!string.IsNullOrWhiteSpace(exhibition.Image))
                            {
                                <img src="@exhibition.Image" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain;" alt="@exhibition.Title">
                            }
                        </div>

                        <div class="col-md-8 card-body bg-white p-5 d-flex flex-column justify-content-center">
                            <h3 class="fw-bold text-uppercase mb-2">@exhibition.Title</h3>
                            <h6 class="text-warning fw-bold mb-4">
                                DAL @exhibition.StartDate.ToString("dd MMM yyyy") AL @exhibition.EndDate.ToString("dd MMM yyyy")
                            </h6>

                            @if (!string.IsNullOrWhiteSpace(exhibition.Description))
                            {
                                <p class="text-muted mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @exhibition.Description
                                </p>
                            }

                            <p class="text-muted mb-4">
                                Stato: <strong>@TraduciStato(exhibition.Status)</strong>
                            </p>

                            <div class="d-flex gap-2 mt-auto">

                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <button class="btn btn-primary fw-bold px-4" @onclick="() => Details(exhibition.Id)">Gestisci Opere</button>
                                        <button class="btn btn-outline-dark fw-bold" @onclick="() => Edit(exhibition.Id)">Modifica</button>
                                        <button class="btn btn-danger fw-bold" @onclick="() => Delete(exhibition.Id)">Elimina</button>
                                    </Authorized>
                                    <NotAuthorized>
                                        <button class="btn btn-primary fw-bold px-4" @onclick="() => Details(exhibition.Id)">Dettagli</button>
                                    </NotAuthorized>
                                </AuthorizeView>

                                <AuthorizeView>
                                    <Authorized>
                                        <button class="btn btn-warning fw-bold px-4" @onclick="() => Prenota(exhibition.Id)">Prenota</button>
                                    </Authorized>
                                </AuthorizeView>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Exhibition>? exhibitions;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        exhibitions = await ApiClient.GetExhibitionsAsync();
    }

    private string TraduciStato(string? status)
    {
        return status?.ToLower() switch
        {
            "scheduled" => "Programmata",
            "active" => "Attiva",
            "closed" => "Chiusa",
            _ => "Stato Sconosciuto"
        };
    }

    private void CreateNew()
    {
        NavigationManager.NavigateTo("/exhibitions/edit");
    }

    private void Edit(Guid id)
    {
        NavigationManager.NavigateTo($"/exhibitions/edit/{id}");
    }

    private void Details(Guid id)
    {
        NavigationManager.NavigateTo($"/exhibitions/details/{id}");
    }

    // NUOVO METODO: Gestisce il click sul tasto Prenota
    private void Prenota(Guid id)
    {
        // Reindirizza l'utente alla pagina di creazione biglietti (o prenotazione)
        // Puoi personalizzare questo URL in base a come è strutturata la tua rotta per i tickets/bookings
        NavigationManager.NavigateTo("/tickets/edit");
    }

    private async Task Delete(Guid id)
    {
        await ApiClient.DeleteExhibitionAsync(id);
        await LoadData();
    }
}