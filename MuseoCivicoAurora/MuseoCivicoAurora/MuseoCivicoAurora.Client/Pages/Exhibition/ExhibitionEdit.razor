@page "/exhibitions/edit"
@page "/exhibitions/edit/{Id:guid}"
@rendermode InteractiveWebAssembly
@using MuseoCivicoAurora.shared
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>@(Id == null ? "Nuova Mostra" : "Modifica Mostra")</h3>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@if (exhibition == null)
{
    <p><em>Caricamento dei dati in corso...</em></p>
}
else
{
    <EditForm Model="exhibition" OnValidSubmit="Save" FormName="formMostra">
        <DataAnnotationsValidator />
        <ValidationSummary style="color: red; font-weight: bold; margin-bottom: 15px;" />

        <div class="mb-3">
            <label class="form-label">Titolo della Mostra (*):</label>
            <InputText class="form-control" @bind-Value="exhibition.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Descrizione:</label>
            <InputTextArea class="form-control" @bind-Value="exhibition.Description" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Data di Inizio (*):</label>
                <InputDate class="form-control" @bind-Value="exhibition.StartDate" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Data di Fine (*):</label>
                <InputDate class="form-control" @bind-Value="exhibition.EndDate" min="@exhibition.StartDate.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">URL Immagine (Locandina):</label>
            <InputText class="form-control" @bind-Value="exhibition.Image" />
        </div>

        <div class="mb-3">
            <label class="form-label">Stato:</label>
            <InputSelect class="form-control" @bind-Value="exhibition.Status">
                <option value="scheduled">Programmata</option>
                <option value="active">Attiva</option>
                <option value="closed">Chiusa</option>
            </InputSelect>
        </div>

        <a type="submit" class="btn btn-success">Salva</a>
        <a href="/exhibitions" class="btn btn-secondary">Annulla</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private Exhibition exhibition = new Exhibition
    {
        StartDate = DateTime.Today,
        EndDate = DateTime.Today.AddDays(30),
        Status = "scheduled"
    };

    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Id.HasValue)
            {
                var fetchedExhibition = await Http.GetFromJsonAsync<Exhibition>($"api/exhibitions/{Id.Value}");
                if (fetchedExhibition != null)
                {
                    exhibition = fetchedExhibition;
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Errore di caricamento: {ex.Message}";
        }
    }

    private async Task Save()
    {
        ErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(exhibition.Title))
        {
            ErrorMessage = "Il titolo è obbligatorio.";
            return;
        }

        if (exhibition.EndDate < exhibition.StartDate)
        {
            ErrorMessage = "ERRORE: La data di fine della mostra non può essere precedente alla data di inizio.";
            return;
        }
        // -------------------------------------

        try
        {
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Errore di rete: {ex.Message}";
        }
    }
}